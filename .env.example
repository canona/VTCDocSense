# ===== VTCDocSense – biến môi trường =====
# Local: cp .env.example .env ; Coolify: khai báo trong tab Environment Variables.
# Mật khẩu nên dùng chuỗi hex (openssl rand -hex 24) để không phải URL-encode.

# --- Ứng dụng ---
# local | staging | production
APP_ENV=production
LOG_LEVEL=INFO
# Bật /docs (OpenAPI); tắt ở production
ENABLE_DOCS=false
# Tự xóa PDF/kết quả sau N ngày
RETENTION_DAYS=30
MAX_FILE_MB=20
MAX_PAGES=30
# Giới hạn 1 request upload ZIP (Cloudflare cắt ở 100MB)
MAX_UPLOAD_MB=100
# Bảo vệ API nội bộ /api/* cho tới khi có Cloudflare Access (M3).
# Có giá trị -> bắt buộc "Authorization: Bearer <token>"; để trống -> /api chỉ mở khi APP_ENV=local
INTERNAL_API_TOKEN=

# --- Đăng nhập giao diện web ---
# cf_access (production): xác minh JWT Cloudflare Access | dev: nhập email tự do (chỉ local, cấm ở production)
AUTH_MODE=cf_access
# Zero Trust > Settings > Custom Pages: <team>.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Zero Trust > Access > Applications > (ứng dụng docsense) > Overview > Application Audience (AUD) Tag
CF_ACCESS_AUD=
# Email luôn có quyền admin (phân cách dấu phẩy)
BOOTSTRAP_ADMIN_EMAILS=
# Pipeline: DPI render ảnh scan, ảnh xám, chất lượng JPEG gửi model
RENDER_DPI=150
IMAGE_GRAYSCALE=true
IMAGE_JPEG_QUALITY=85
# Tỷ lệ trường "low" vượt ngưỡng -> thử provider phụ (khi FALLBACK_ENABLED=true)
LOW_CONF_FALLBACK_RATIO=0.3

# --- Postgres ---
POSTGRES_USER=docsense
POSTGRES_PASSWORD=change-me-hex
POSTGRES_DB=docsense

# --- Redis ---
REDIS_PASSWORD=change-me-hex

# --- Kỷ luật token (BẮT BUỘC đọc) ---
# Mặc định KHÔNG gọi API LLM thật. Bật =true chỉ khi cố ý chạy thật (tốn tiền).
# Phản hồi đã có trong cache (<DATA_DIR>/llm_cache) vẫn dùng được khi tắt.
ALLOW_LIVE_LLM=false
# Ngân sách cứng/ngày (đồng, theo sổ <DATA_DIR>/llm_ledger) và số lượt gọi thật tối đa/run
# (1 run = 1 lệnh CLI hoặc 1 document trong worker). Vượt -> dừng, báo lỗi.
LLM_DAILY_BUDGET_VND=50000
LLM_MAX_CALLS_PER_RUN=10
LLM_CACHE_ENABLED=true
# Đơn giá token: sửa config/pricing.toml. LLM_REQUIRE_PRICING=true -> model chưa có giá bị từ chối gọi thật;
# false -> vẫn gọi, chi phí ghi 0 (ngân sách ngày mất tác dụng, chỉ còn LLM_MAX_CALLS_PER_RUN)
LLM_REQUIRE_PRICING=false
# Phân tầng model (ghi đè model của provider chính):
#   Tên model lấy từ GET /models của key (Gemini: gemini-x.y-flash-lite / gemini-x.y-flash ...)
#   MODEL_TEXT  : model rẻ cho PDF có lớp chữ + phân loại (vd dòng flash-lite / mini)
#   MODEL_VISION: model mạnh hơn cho scan/chữ viết tay (được ghi danh sách "a,b": 429/503 -> model kế); đích escalate khi JSON sai
#                 hoặc trường trọng yếu low. Để trống = dùng model mặc định của provider.
MODEL_TEXT=
MODEL_VISION=
# max_tokens output cho bóc tách / phân loại
MAX_OUTPUT_TOKENS=8192
# Mức "thinking" (none|minimal|low|medium|high). Trống: gemini dùng low; provider khác không gửi
LLM_REASONING_EFFORT=
CLASSIFY_MAX_TOKENS=300
# Batch API của nhà cung cấp (rẻ ~50%, cho lô lớn không cần kết quả ngay) - CHƯA triển khai
USE_BATCH_API=false

# --- Provider ---
# mock | gemini | openai | anthropic | openai_compat | router | vllm
LLM_PROVIDER=mock
FALLBACK_ENABLED=false
# Provider phụ khi provider chính lỗi/hết quota mọi model, vd: router
FALLBACK_PROVIDER=
PROVIDER_TIMEOUT_S=120
PROVIDER_MAX_RETRIES=2

# vLLM (chỉ khi chạy profile gpu: docker compose --profile gpu up)
MODEL_NAME=Qwen/Qwen3-VL-8B-Instruct
# Nên pin version cụ thể khi lên production
VLLM_TAG=latest
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_MEM_UTIL=0.90
VLLM_MAX_IMAGES=8
VLLM_GPU_COUNT=1
# Chỉ cần với model gated
HF_TOKEN=

# Gemini (LLM_PROVIDER=gemini): key từ Google AI Studio; model mặc định khi không đặt MODEL_TEXT/VISION
GEMINI_API_KEY=
GEMINI_MODEL=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# OpenAI (LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI-compatible: OpenAI, Gemini, Ollama, ... (dùng khi chưa có GPU)
#   Gemini : OPENAI_COMPAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#            OPENAI_COMPAT_API_KEY=<key từ Google AI Studio>
#   OpenAI : OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
#            OPENAI_COMPAT_API_KEY=<key OpenAI>
#   OPENAI_COMPAT_MODEL: model đọc được ảnh (vision). Có 3 cách:
#     - 1 model:            gemini-3.8-flash
#     - danh sách ưu tiên:  gemini-3.8-flash,gemini-3.5-flash,gemini-3.1-flash-lite
#                           (429 hết quota / 404 / 503 -> tự chuyển model kế tiếp)
#     - auto:               tự lấy danh sách từ GET /models của key, bỏ model tạo ảnh/TTS/embedding,
#                           ưu tiên bản ổn định, flash > pro > lite, phiên bản mới trước
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# Regex lọc model khi OPENAI_COMPAT_MODEL=auto (tùy chọn), vd: gemini
OPENAI_COMPAT_MODEL_FILTER=
# json_schema (strict) | json_object (schema đặt trong prompt). Tự hạ cấp nếu endpoint trả 400.
OPENAI_COMPAT_RESPONSE_FORMAT=json_schema

# 9router (https://9router.vtcdigital.top) - OpenAI-compatible, dùng LLM_PROVIDER=router
# hoặc làm dự phòng: FALLBACK_ENABLED=true + FALLBACK_PROVIDER=router
ROUTER_BASE_URL=https://9router.vtcdigital.top/v1
# API key tạo trong dashboard 9router
ROUTER_API_KEY=
# 1 model / danh sách "a,b" / auto (như OPENAI_COMPAT_MODEL)
ROUTER_MODEL=auto
ROUTER_MODEL_FILTER=

# --- Worker ---
WORKER_CONCURRENCY=2
JOB_TIMEOUT_S=900

# --- Cloudflare ---
# Chỉ khi dùng service cloudflared trong compose (--profile tunnel)
TUNNEL_TOKEN=
CLOUDFLARED_TAG=latest
# Hostname: web docsense.vtcdigital.top (sau Cloudflare Access), API đối tác apidocsense.vtcdigital.top (bypass Access)

# --- Bảo mật API ---
# Chuỗi bí mật trộn vào hash API key (openssl rand -hex 32). Đổi giá trị -> mọi key cũ mất hiệu lực
API_KEY_PEPPER=

# --- API đối tác /v1 (M4) ---
# /v1/docs + /v1/openapi.json (chỉ route đối tác) - độc lập với ENABLE_DOCS
PARTNER_DOCS=true
# Request/phút/API key (tenant ghi đè được trong trang Quản trị)
API_RATE_LIMIT_PER_MINUTE=60
API_MAX_FILES_PER_REQUEST=20
IDEMPOTENCY_TTL_HOURS=24
# Webhook: secret ký HMAC riêng từng tenant (tạo/xoay trong trang Quản trị), không đặt ở đây
WEBHOOK_TIMEOUT_S=10
WEBHOOK_MAX_ATTEMPTS=8
# true: cho webhook tới http:// / địa chỉ nội bộ (localhost, 10.x...). CHỈ dùng dev - production để false (SSRF)
WEBHOOK_ALLOW_PRIVATE=false
