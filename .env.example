# ===== GP-OCR – biến môi trường =====
# Local: cp .env.example .env ; Coolify: khai báo trong tab Environment Variables.
# Mật khẩu nên dùng chuỗi hex (openssl rand -hex 24) để không phải URL-encode.

# --- Ứng dụng ---
# local | staging | production
APP_ENV=production
LOG_LEVEL=INFO
# Bật /docs (OpenAPI); tắt ở production
ENABLE_DOCS=false
# Tự xóa PDF/kết quả sau N ngày
RETENTION_DAYS=30
MAX_FILE_MB=20
MAX_PAGES=30

# --- Postgres ---
POSTGRES_USER=gpocr
POSTGRES_PASSWORD=change-me-hex
POSTGRES_DB=gpocr

# --- Redis ---
REDIS_PASSWORD=change-me-hex

# --- Provider ---
# mock | vllm | anthropic | openai_compat
LLM_PROVIDER=mock
FALLBACK_ENABLED=false
# vd: anthropic
FALLBACK_PROVIDER=
PROVIDER_TIMEOUT_S=120
PROVIDER_MAX_RETRIES=2

# vLLM (chỉ khi chạy profile gpu: docker compose --profile gpu up)
MODEL_NAME=Qwen/Qwen3-VL-8B-Instruct
# Nên pin version cụ thể khi lên production
VLLM_TAG=latest
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_MEM_UTIL=0.90
VLLM_MAX_IMAGES=8
VLLM_GPU_COUNT=1
# Chỉ cần với model gated
HF_TOKEN=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI-compatible khác
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# --- Worker ---
WORKER_CONCURRENCY=2
JOB_TIMEOUT_S=900

# --- Cloudflare ---
# Chỉ khi dùng service cloudflared trong compose (--profile tunnel)
TUNNEL_TOKEN=
CLOUDFLARED_TAG=latest
# M3: CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
# M3: CF_ACCESS_AUD=

# --- Bảo mật API ---
# M2: API_KEY_PEPPER=
# M5: WEBHOOK_SIGNING_SECRET=
